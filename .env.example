# ===========================================
# AFEIA Practitioner Web - Environment Variables
# ===========================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# ----- Supabase (Base de données & Auth) -----
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service-secrète

# ----- Application -----
# En développement local :
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En production (Vercel), utilisez :
# NEXT_PUBLIC_APP_URL=https://afeia.fr

# ----- Questionnaire OTP -----
QUESTIONNAIRE_CODE_PEPPER=change-moi
QUESTIONNAIRE_CODE_TTL_MINUTES=30
QUESTIONNAIRE_JWT_SECRET=change-moi

# ----- Email Provider (Resend) -----
# Obtenez votre clé API sur https://resend.com/api-keys
RESEND_API_KEY=

# Adresse d'expédition des emails (domaine vérifié requis pour envoyer à tous)
# IMPORTANT: Le domaine doit être vérifié sur https://resend.com/domains
RESEND_FROM_EMAIL=AFEIA <contact@afeia.fr>

# ----- Stripe (Paiements & Abonnements) -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe Product & Price IDs
STRIPE_PRODUCT_ID=prod_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# Webhook Secret (production only)
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- IA - Anthropic API -----
# Clé API pour l'assistance IA (génération de conseillanciers)
# Obtenez votre clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----- Optionnel : Circular Ring API (pour plus tard) -----
# CIRCULAR_API_KEY=votre-clé-circular
# CIRCULAR_WEBHOOK_SECRET=votre-secret-webhook

# Vidéo de présentation affichée sur /decouvrir (MP4 ou WebM hébergé)
NEXT_PUBLIC_PRESENTATION_VIDEO_URL=

# ----- Polar AccessLink v3 (objets connectés : Polar Loop) -----
# Serveur uniquement (jamais de préfixe NEXT_PUBLIC_). Facultatives pour le reste de l'app :
# rien n'est vérifié au démarrage. Si l'une manque ou est invalide, seules les routes Polar qui
# en ont besoin répondent 503 (nom de la variable dans les logs) ; tout le reste fonctionne.
# connexion / callback OAuth : les 4 variables ci-dessous.
# Deux clients sur https://admin.polaraccesslink.com (un webhook par client) :
#   - « Afeia dev »  → POLAR_REDIRECT_URI=http://localhost:3000/api/wearables/polar/callback
#   - « Afeia prod » → POLAR_REDIRECT_URI=https://afeia.fr/api/wearables/polar/callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=
# Secret de signature du paramètre state OAuth (propre à Afeia, ≥ 32 caractères).
# Générer avec : openssl rand -hex 32 (valeur différente par environnement)
POLAR_STATE_SECRET=
# Secret de signature des webhooks Polar : affiché UNE fois par `npm run polar:webhook create`.
# Seule la route /api/webhooks/polar en dépend. Tant qu'il est vide, elle répond 200 au PING
# (nécessaire pour créer le webhook) et 503 aux autres événements.
POLAR_WEBHOOK_SECRET=

# ----- Objets connectés : ouverture progressive -----
# internal (défaut) : seuls les comptes listés ci-dessous voient « Connecter mon objet connecté »
# et /api/wearables/polar/connect répond 403 aux autres. all : tout le monde (aucun code à changer).
# ⚠ Ne passer à « all » en Production qu'après validation de docs/wearables/hds-decision.md.
WEARABLES_ENABLED_FOR=internal
# E-mails de l'équipe (adresse e-mail de la fiche consultant), séparés par des virgules.
WEARABLES_INTERNAL_EMAILS=

# ----- Crons Vercel -----
# Vercel envoie Authorization: Bearer <CRON_SECRET> aux routes déclarées dans vercel.json.
# Requis par /api/cron/polar-sync (503 sans secret, 401 si l'en-tête est faux). Générer : openssl rand -hex 32
CRON_SECRET=
